      "crossfade_ms": 40,
      "include_role_stems": true,
      "include_scene_stems": true,
      "create_zip": true,
      "master_audio": [
        "2",
        0
      ],
      "bgm_audio": [
        "3",
        0
      ],
      "room_tone_audio": [
        "4",
        0
      ],
      "delivery_preset": [
        "5",
        0
      ]
    }
  }
}