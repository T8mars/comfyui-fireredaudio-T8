      "continue_on_error": true,
      "batch_size": 8,
      "settings": [
        "8",
        0
      ]
    }
  },
  "10": {
    "class_type": "T8_FireRedAudio_TimelineRender",
    "inputs": {
      "audio_batch": [
        "9",
        0
