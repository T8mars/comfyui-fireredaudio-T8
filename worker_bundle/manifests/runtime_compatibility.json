{
  "schemaVersion": 1,
  "runtimeId": "win-x64-py310-torch2.8.0-cu128-transformers5.8.0-r1",
  "worker": {
    "python": "3.10.x",
    "torch": "2.8.0",
    "torchaudio": "2.8.0",
    "torchcodec": "0.11.1 (non-Windows only; no win_amd64 wheel)",
    "transformers": "5.8.0",
    "numpy": "2.2.6",
    "einops": "0.8.2",
    "cudaWheelChannel": "cu128",
    "windowsAudioDecode": "stdlib PCM16 WAV fast path plus bundled ffmpeg-static transcoding"
  },
  "comfyuiHost": {
    "strategy": "out-of-process",
    "installedDependencies": [],
    "mustNotModify": ["torch", "torchaudio", "torchcodec", "transformers", "numpy"],
    "knownTargetTransformers": ["4.52.1", "4.57.6", "5.x"]
  },
  "acceleration": {
    "default": "auto_safe",
    "optional": {
      "flash-linear-attention": "0.5.0",
      "liger-kernel": "0.8.0",
      "triton-windows": "3.4.0.post21",
      "flash-attn": "2.8.3",
      "deepspeed": "0.17.5+e1560d84"
    },
    "modes": ["off", "auto_safe", "flash_attention", "fla_liger", "torch_compile", "deepspeed"],
    "policy": "Windows compiled packages use audited CPython 3.10 / Torch 2.8 / CUDA 12.8 wheels only. No local compilation is attempted; unavailable or incompatible modes fall back to SDPA with an explicit diagnostic."
  },
  "memory": {
    "default": "auto",
    "autoFullGpuMinimumGiB": 36,
    "modes": ["auto", "full_gpu", "sequential", "decoder_cpu"],
    "policy": "Generation uses sequential main-model/decoder CUDA residency below 36 GiB; understanding tasks do not load the decoder."
  }
}
